#ifndef BASE_XH
#define BASE_XH

#define KEY_ESC 27
#define KEY_ENTER 13
#define KEY_TAB 9
#define KEY_BACKSPACE 8
#define KEY_EQ 61
#define KEY_SPACE 32

#define KEY_0 48
#define KEY_1 49
#define KEY_2 50
#define KEY_3 51
#define KEY_4 52
#define KEY_5 53
#define KEY_6 54
#define KEY_7 55
#define KEY_8 56
#define KEY_9 57

#define KEY_A 97
#define KEY_B 98
#define KEY_C 99
#define KEY_D 100
#define KEY_E 101
#define KEY_F 102
#define KEY_G 103
#define KEY_H 104
#define KEY_I 105
#define KEY_J 106
#define KEY_K 107
#define KEY_L 108
#define KEY_M 109
#define KEY_N 110
#define KEY_P 112
#define KEY_Q 113
#define KEY_R 114
#define KEY_S 115
#define KEY_T 116
#define KEY_U 117
#define KEY_V 118
#define KEY_W 119
#define KEY_X 120
#define KEY_Y 121
#define KEY_Z 122
#define KEY_SEMI 59

#define KEY_EXT_LEFT 0x4B00
#define KEY_EXT_RIGHT 0x4D00
#define KEY_EXT_UP 0x4800
#define KEY_EXT_DOWN 0x5000

int key_char(int key) {
  return key & 255;
}

int is_digit_char(int ch) {
  if (ch >= KEY_0 && ch <= KEY_9) return 1;
  return 0;
}

int digit_from_char(int ch) {
  return ch - KEY_0;
}

void ui_rule() {
  print("----------------------------------------");
}

void ui_cursor_show() {
  cursor_show();
}

void ui_cursor_hide() {
  cursor_hide();
}

void ui_cursor_set(int row, int col) {
  cursor_set(row, col);
}

#endif
