# 16비트 COM 파일 형식
FORMAT RAW BIN
# 옵션
OPTION NODEFAULTLIBS
OPTION START=_start
OPTION MAP=build/bin/kernel.map

# Layout (RAW BIN):
# - wlink's RAW output omits BSS, and doesn't reliably honor segmented placement (SEGADDR).
# - After link, we repack the image via tools/pack_kernel_image.py to embed zero-filled BSS
#   so CODE bytes land at their link-time addresses.

file build/obj/dgroup_marker.obj
file build/obj/bss_start.obj
file build/obj/code_marker.obj
file build/obj/kernel_entry.obj
file build/obj/kernel.obj
file build/obj/api.obj
file build/obj/sima_mem.obj
file build/obj/sima_conv.obj
file build/obj/sima_ide.obj
file build/obj/sima_fs.obj
file build/obj/sima_program.obj
file build/obj/sima_proc.obj
file build/obj/sima_syscall.obj
file build/obj/xef_loader.obj
file build/obj/xef_exec.obj
file build/obj/sima_env.obj
file build/obj/sima_user.obj
file build/obj/sima_perm.obj
file build/obj/math_helpers.obj
file build/obj/sima_heap.obj
file build/obj/sima_ioport.obj
file build/obj/commands.obj
file build/obj/code_end.obj
file build/obj/bss_end.obj

name build/bin/kernel.img
